# Copy to .env next to docker-compose.images.yml.
# Generate secrets (URL-safe password; 64 hex for ENCRYPTION_KEY):
#   openssl rand -hex 16   # POSTGRES_PASSWORD
#   openssl rand -hex 32   # BETTER_AUTH_SECRET and SCREEN_PROXY_SECRET
#   openssl rand -hex 32   # ENCRYPTION_KEY

POSTGRES_USER=rakazo
POSTGRES_PASSWORD=
POSTGRES_DB=rakazo

BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=

# Public origin the browser uses. For a VPS, put TLS in front of :5173 and use https://…
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
API_URL=http://127.0.0.1:5173
RAKAZO_HOST=localhost

SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=

# edge tracks main (amd64 only). Pin a published release tag when you need arm64 or a fixed version.
RAKAZO_IMAGE=ghcr.io/elie222/rakazo/app
RAKAZO_IMAGE_TAG=edge

# none boots signup/UI without computers. Set e2b, daytona, or box and the matching key for computers.
SANDBOX_PROVIDER=none
# E2B_API_KEY=
# DAYTONA_API_KEY=
# BOX_API_KEY=

# Optional model / integration keys
OPENROUTER_API_KEY=
COMPOSIO_API_KEY=
